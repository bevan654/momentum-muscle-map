{
  "name": "momentum-muscle-map",
  "version": "0.1.0",
  "description": "Detailed, interactive muscle map for React Native",
  "license": "UNLICENSED",
  "private": true,
  "repository": "github:bevan654/momentum-muscle-map",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./core": {
      "types": "./lib/typescript/core/index.d.ts",
      "default": "./lib/module/core/index.js"
    },
    "./data/*": {
      "types": "./lib/typescript/data/*.d.ts",
      "default": "./lib/module/data/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "NOTICE",
    "!**/__tests__"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bob build",
    "prepare": "bob build",
    "gen:data": "node scripts/gen-data.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.2.0",
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-reanimated": ">=4.1.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.2.12",
    "@types/react": "~19.1.0",
    "react": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.44.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "^0.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/__tests__/**",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
